# 25PageScript Mobile App Environment Variables
# Copy this file to .env and fill in your values

# API URL - Your deployed API Gateway URL
# For local development with serverless-offline:
# EXPO_PUBLIC_API_URL=http://localhost:3000/dev

# For production deployment:
# EXPO_PUBLIC_API_URL=https://your-api-id.execute-api.ap-south-1.amazonaws.com/prod

EXPO_PUBLIC_API_URL=http://localhost:3000/dev
